{
  "name": "the-settlers-iii-remake",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "A browser settlement strategy game built with Stacks, stx and Craft",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "build:reset": "rm -rf node_modules && pantry install && ./buddy generate:types && ./buddy lint:fix",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "./buddy dev",
    "development": "./buddy dev",
    "build": "./buddy build views",
    "prod": "./buddy build",
    "deploy": "./buddy deploy",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch",
    "release:calendar": "./buddy release --bump calendar",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck": "bun run typecheck:app && bun run typecheck:tools && bun run typecheck:views",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:views": "bun x --bun stx typecheck --lib storage/framework/types/request-context.d.ts --lib storage/framework/types/browser-composables.d.ts 'resources/**/*.stx'",
    "typecheck:clean": "bunx --bun rimraf storage/framework/.cache/typescript",
    "types:check": "bun run typecheck",
    "types:fix": "./buddy types:fix",
    "test": "./buddy test",
    "test:browser": "bun tests/browser/campaign.ts",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "bud": "./buddy",
    "stx": "./buddy",
    "probe:integrations": "./buddy integrations:probe",
    "assets:import": "bun scripts/import-assets.ts",
    "prebuild": "bun run assets:import",
    "assets:verify": "bun scripts/verify-assets.ts",
    "typecheck:tools": "bun x --bun tsc --noEmit -p tsconfig.tools.json --pretty false"
  },
  "dependencies": {
    "@stacksjs/actions": "^0.75.253",
    "@stacksjs/env": "^0.75.253",
    "@stacksjs/path": "^0.75.253",
    "@stacksjs/stx": "0.2.631",
    "craft-native": "0.0.262",
    "stacks": "^0.75.253"
  },
  "workspaces": [
    "storage/framework",
    "storage/framework/libs/*",
    "storage/framework/views/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit \"$1\""
  },
  "devDependencies": {
    "@stacksjs/components": "0.2.631",
    "@stacksjs/ts-png": "^0.1.8",
    "better-dx": "^0.2.37",
    "bun-plugin-stx": "0.2.631"
  },
  "author": "Chris <chris@stacksjs.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/the-settlers-iii-remake.git"
  },
  "homepage": "https://github.com/stacksjs/the-settlers-iii-remake",
  "bugs": {
    "url": "https://github.com/stacksjs/the-settlers-iii-remake/issues"
  }
}
