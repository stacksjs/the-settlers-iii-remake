<script server>
const repository = 'https://github.com/stacksjs/the-settlers-iii-remake'

const features = [
  { title: 'Real logistics', body: 'Carriers fetch each plank and stone from where it lies, diggers level the site, and builders build from delivered material. Construction deliveries come before storage.' },
  { title: 'Tools and trades', body: 'Woodcutters need an axe, miners a pick, sawyers a saw. A workplace without its tool says so instead of hiring a phantom worker.' },
  { title: 'Soldiers and borders', body: 'Soldiers are recruited from carriers holding real weapons, garrison towers, fight and capture buildings. Pioneers push the border outward.' },
  { title: 'A computer rival', body: 'The rival surveys, expands, builds an economy and attacks through the same commands you use. Capture every enemy castle and tower to win.' },
  { title: 'Seeds and saves', body: 'Reuse a map seed for the same landscape. Settlements, seed and mission outcome survive save and reload on your device.' },
  { title: 'Keyboard first', body: 'Choosing a building moves the cursor to the nearest valid site and Enter places it. Dialogs contain focus and restore it when closed.' },
]

const shots = [
  { src: '/showcase/settlement.webp', alt: 'A Roman settlement with a castle, woodcutters, a stonecutter and a sawmill at work on a green hex island.', title: 'A settlement that really works', caption: 'Woodcutters, a forester, a stonecutter and a sawmill: each building staffed by a settler who walked there with the right tool.' },
  { src: '/showcase/tutorial.webp', alt: 'The original tutorial map from the Amazons demo, with a guard tower, goods on the ground and many soldiers standing around.', title: 'The original tutorial map', caption: 'Decoded from the free Amazons demo, with its own terrain, tower, tools and starting goods.' },
  { src: '/showcase/rival.webp', alt: 'A Roman castle with a sawmill and other workshops among trees, with the objectives panel open.', title: 'Skirmish against a computer rival', caption: 'The rival expands, builds and fights through the same commands you use. Capture every enemy castle and tower to win.' },
]

const more = shots.slice(1)

const status = [
  '12 epics and more than 100 implementation issues, linked to the framework repositories that own each defect.',
  'A fidelity audit that lists verified matches and known gaps.',
  'Production browser acceptance runs on every push.',
]
</script>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="A free browser remake of The Settlers III. Sign in to play: every settler, tool and good is a real object in a deterministic settlement simulation.">
  <meta property="og:title" content="The Settlers III Remake">
  <meta property="og:description" content="Play a Roman settlement where every settler walks and every plank is carried.">
  <meta property="og:image" content="/showcase/settlement.webp">
  <title>The Settlers III Remake</title>
</head>
<body class="m-0 antialiased text-stone-900 dark:text-stone-100 bg-amber-50 dark:bg-stone-950">
  <a href="#main" class="focus:absolute focus:left-2 focus:top-2 focus:px-3 focus:py-2 focus:text-white focus:bg-stone-900 sr-only focus:not-sr-only">Skip to content</a>
  <SiteHeader />

  <main id="main">
    <section class="mx-auto pb-10 pt-12 px-4 sm:pt-16 sm:px-6 max-w-6xl">
      <p class="m-0 mb-3 font-semibold text-amber-800 text-xs tracking-widest uppercase dark:text-amber-400">Free to play in your browser</p>
      <h1 class="m-0 mb-5 max-w-3xl font-bold leading-tight text-4xl tracking-tight sm:text-6xl">Every settler walks. Every plank is carried.</h1>
      <p class="m-0 mb-7 max-w-2xl text-stone-600 text-xl dark:text-stone-400">A browser remake of The Settlers III, built on a deterministic simulation in which each settler, tool and good is a real object in the world. If a carrier has not delivered the stone, the wall does not rise.</p>
      <p class="flex flex-wrap gap-3 m-0">
        <a href="/play" class="px-6 py-3 font-semibold no-underline text-stone-950 bg-amber-600 rounded-xl hover:brightness-110">Play now</a>
        <a href="/register?redirect=/play" class="px-6 py-3 font-semibold no-underline text-stone-900 dark:text-stone-100 bg-white dark:bg-stone-900 border border-stone-300 rounded-xl dark:border-stone-700">Create a free account</a>
      </p>
      <p class="mb-0 mt-3 text-sm text-stone-600 dark:text-stone-400">An account keeps your settlement tied to you. Sign in to play.</p>
    </section>

    <section class="mx-auto px-4 sm:px-6 max-w-6xl">
      <ShowcaseFigure src="/showcase/settlement.webp" alt="A Roman settlement with a castle, woodcutters, a stonecutter and a sawmill at work on a green hex island." title="A settlement that really works" caption="Woodcutters, a forester, a stonecutter and a sawmill: each building staffed by a settler who walked there with the right tool." priority="true" />
    </section>

    <section id="screens" aria-labelledby="screens-title" class="mx-auto px-4 py-14 sm:px-6 max-w-6xl">
      <h2 id="screens-title" class="m-0 mb-6 font-bold text-3xl tracking-tight">See it running</h2>
      <div class="grid gap-6 lg:grid-cols-2">
        @foreach (more as shot)
          <ShowcaseFigure src="{{ shot.src }}" alt="{{ shot.alt }}" title="{{ shot.title }}" caption="{{ shot.caption }}" />
        @endforeach
      </div>
    </section>

    <section id="simulation" aria-labelledby="simulation-title" class="mx-auto px-4 py-6 sm:px-6 max-w-6xl">
      <h2 id="simulation-title" class="m-0 mb-6 font-bold text-3xl tracking-tight">A settlement that works the way it looks</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (features as feature)
          <FeatureCard title="{{ feature.title }}" body="{{ feature.body }}" />
        @endforeach
      </div>
    </section>

    <section id="status" aria-labelledby="status-title" class="mx-auto my-10 px-5 py-9 sm:px-10 max-w-6xl bg-amber-100 dark:bg-stone-900 rounded-3xl">
      <h2 id="status-title" class="m-0 mb-6 font-bold text-3xl tracking-tight">Where it stands</h2>
      <p class="mt-0 max-w-2xl">This is a faithful-remake effort, not a finished game. It does not yet reproduce the original promotions, other civilizations, ships, campaigns or measured timings. Each claim is tracked as a public issue with its evidence, and a feature is only marked done when its acceptance checks pass in a real browser.</p>
      <ul class="pl-5 max-w-2xl list-disc">
        @foreach (status as item)
          <li>{{ item }}</li>
        @endforeach
      </ul>
      <p class="mb-0 mt-4 max-w-2xl text-sm text-stone-600 dark:text-stone-400">Open source, built with <a href="https://stacksjs.com" class="text-amber-800 dark:text-amber-400">Stacks</a>, stx and Craft. <a href="{{ repository }}/tree/main/docs/roadmap" class="text-amber-800 dark:text-amber-400">Read the roadmap</a>.</p>
    </section>
  </main>

  <SiteFooter />
</body>
</html>
