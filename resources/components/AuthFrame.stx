</div>

<style>
/* The Stacks auth card centres itself in a full-height box and carries its own
   blue cube tile. Inside the game's frame it sits directly under the castle mark
   instead, so the box shrinks to its content and the stock tile steps aside. */
.auth-frame .min-h-screen { min-height: 0; }
.auth-frame .py-12 { padding-top: 0.75rem; padding-bottom: 1.5rem; }
.auth-frame [class*="from-blue-500"][class*="rounded-xl"] { display: none; }
</style>
