  <img src="{{ src }}" alt="{{ alt }}" width="1440" height="900" loading="{{ priority ? 'eager' : 'lazy' }}" decoding="async" class="block h-auto w-full">
  <figcaption class="px-5 py-4">
    <strong class="block text-base">{{ title }}</strong>
    <span class="block text-sm text-stone-600 dark:text-stone-400">{{ caption }}</span>
