  "acceptance": [
    {
      "criterion": "Atlas regions and player tint",
      "evidence": "drawSprite samples explicit atlas UV regions, transforms and player masks. Exact clipped/tinted pixels, offset regions and full-atlas mask indexing are tested."
    },
    {
      "criterion": "Clipping, transforms, ordering and bitmap text",
      "evidence": "Actual sprite mirroring/rotation, watertight textured triangle edges, glyph/newline/Unicode placement and stable ordered-frame pixels are covered. Missing glyph, invalid font metadata and malformed UTF-8 fail before pixel writes."
    },
    {
      "criterion": "Bounded asset and frame memory",
      "evidence": "The real allocator failure loop checks canvas cleanup. View, pixel-work, command, text and aggregate asset budgets reject before writes; shared views deduplicate without dropping command validation. Repeated drawFrame calls allocate no frame storage."
    },
    {
      "criterion": "Actual visible pixel values and failure paths",
      "evidence": "Maintained native Zig tests inspect actual sprite, triangle and glyph buffers, including invalid UVs/NaNs/degenerate geometry/aliasing. Invalid later commands leave the original frame intact."
    },
    {
      "criterion": "Maintained public consumption",
      "evidence": "The original published Zig package builds unchanged in a cold independent consumer. The consumer executes the public graphics.scene API and compares exact bitmap/terrain/glyph/atomic frame pixels. Retained binary rerun passed after compiler cache cleanup."
    }
