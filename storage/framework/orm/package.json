{
  "name": "stacks-orm",
  "type": "module",
  "version": "0.75.251",
  "description": "Your custom ORM.",
  "license": "MIT",
  "keywords": [
    "orm",
    "functions",
    "stacks"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "bun": "./*",
      "import": "./dist/*"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@stacksjs/bun-router": "^0.1.24",
    "@stacksjs/cache": "0.75.328",
    "@stacksjs/database": "0.75.328",
    "@stacksjs/error-handling": "0.75.328"
  },
  "devDependencies": {
    "better-dx": "^0.2.24"
  }
}
